    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "openai": "^4.47.1",
    "postgres": "^3.4.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^3.0.5"
  }
}
