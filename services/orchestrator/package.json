{
  "name": "@chusterm/orchestrator",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test test/orchestrator.test.ts",
    "eval:dr-paula": "npm run build && node scripts/evaluate-dr-paula.mjs",
