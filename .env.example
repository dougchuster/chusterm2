# =============================================================================
# ChusteRM — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# =============================================================================

# ─── Geral ───────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=ChusteRM

# ─── ChusteRM Core (fork Chatwoot) ───────────────────────────────────────────
# Signup público SEMPRE desabilitado
ENABLE_ACCOUNT_SIGNUP=false

# Enterprise edition DESABILITADA — usamos clean-room para features
DISABLE_ENTERPRISE=true

SECRET_KEY_BASE=GERE_COM_rails_secret
FRONTEND_URL=http://localhost:3000

# Banco principal do Core
DATABASE_URL=postgresql://chusterm:chusterm_pass@postgres:5432/chusterm_core

# Redis compartilhado
REDIS_URL=redis://:chusterm_redis_pass@redis:6379/0

# E-mail transacional
MAILER_SENDER_EMAIL=noreply@chusterm.example.com
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=false

# Object storage (desenvolvimento: local; produção: S3/GCS/R2)
ACTIVE_STORAGE_SERVICE=local

# Sentry (APM) — deixar vazio em dev
SENTRY_DSN=

# ARQ-02: crm-service aposentado — o CRM vive no Rails (tabelas crm_*);
# variáveis CRM_SERVICE_INTERNAL_URL/CRM_PORT/CRM_DB_URL/CRM_REDIS_URL removidas.

# JWT para comunicação interna serviço-a-serviço
SERVICE_JWT_SECRET=TROQUE_POR_SEGREDO_FORTE_256bits
SERVICE_JWT_EXPIRY=15m

# ─── Agent Orchestrator ──────────────────────────────────────────────────────
ORCHESTRATOR_PORT=4001
ORCHESTRATOR_DB_URL=postgresql://chusterm:chusterm_pass@postgres:5432/chusterm_ai
ORCHESTRATOR_REDIS_URL=redis://:chusterm_redis_pass@redis:6379/2

# Webhook recebido do Chatwoot Core
CHATWOOT_WEBHOOK_SECRET=TROQUE_POR_SEGREDO_HMAC

# SEC-02: segredo obrigatório do POST /agent/message (header x-webhook-secret
# ou ?token= na URL do agent_bot)
ORCHESTRATOR_WEBHOOK_SECRET=TROQUE_POR_SEGREDO_FORTE

# Agent Bot token do ChusteRM Core
CHATWOOT_BOT_TOKEN=

# Base URL interna do ChusteRM Core
CHATWOOT_BASE_URL=http://core:3000


# ─── Provedores de LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
# Gateway único. Os fornecedores são selecionados pelo slug do modelo no OpenRouter.

LLM_API_KEY=
LLM_MODEL=google/gemini-3.7-flash
CAPTAIN_DRA_LETICIA_LLM_MODEL=anthropic/claude-sonnet-5
CAPTAIN_DRA_LETICIA_SUMMARIZER_MODEL=google/gemini-3.7-flash
ORCHESTRATOR_DRA_LETICIA_LLM_MODEL=anthropic/claude-sonnet-5
LLM_ATTENDANCE_TEST_MODEL=deepseek/deepseek-v4-flash
LLM_CODING_TEST_MODEL=z-ai/glm-5.2
LLM_BASE_URL=https://openrouter.ai/api/v1
CAPTAIN_MEDIA_AI_FALLBACK_MODELS=anthropic/claude-sonnet-5,google/gemini-2.5-flash
CAPTAIN_AUDIO_TRANSCRIPTION_FALLBACK_MODELS=openai/gpt-4o-mini-transcribe,openai/whisper-large-v3
LLM_MAX_TOKENS_PER_SESSION=4096
LLM_TIMEOUT_MS=60000

# ─── Evolution API (WhatsApp não-oficial via Baileys) ────────────────────────
# Evolution API (serviço evolution-api neste docker-compose)
# - Dentro da rede Docker o Core chama na porta 8080 do container (hostname evolution-api).
# - No Windows/host (curl, browser): http://localhost:8085 (mapeamento 8085:8080 do compose).
# Não use http://localhost:8080 na URL do canal se o Core rodar dentro do Docker — localhost seria o próprio container Core.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_WEBHOOK_BASE_URL=http://core:3000
EVOLUTION_API_KEY=evo_chusterm_secret_key
EVOLUTION_LOG_LEVEL=INFO
# URL pública do servidor Evolution (usada na UI do Manager e links de QR code).
# Em produção, use o domínio real (ex: https://evo.seudominio.com).
EVOLUTION_SERVER_URL=http://localhost:8085
