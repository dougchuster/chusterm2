# =============================================================================
# ChusteRM — Variáveis de Ambiente PRODUÇÃO
# VPS: 187.77.255.211 | Domínio: crm.coimbraeruas.com.br
#
# 1. Copie para .env na VPS: cp .env.prod.example .env
# 2. Preencha TODOS os valores marcados com PREENCHER
# 3. NUNCA commite o .env no repositório
# =============================================================================

# ─── Geral ───────────────────────────────────────────────────────────────────
APP_ENV=production
APP_NAME=ChusteRM
RAILS_ENV=production
NODE_ENV=production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=chusterm
POSTGRES_PASSWORD=PREENCHER_SENHA_FORTE_POSTGRES

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=PREENCHER_SENHA_FORTE_REDIS

# ─── ChusteRM Core (fork Chatwoot) ───────────────────────────────────────────
ENABLE_ACCOUNT_SIGNUP=false
DISABLE_ENTERPRISE=true

# Gerar com: openssl rand -hex 64
SECRET_KEY_BASE=PREENCHER_COM_openssl_rand_hex_64

# Active Record Encryption (OBRIGATÓRIO em produção — sem estas chaves, tokens OAuth
# do Google, API key da Evolution e segredos de webhook ficam em TEXTO PLANO no banco
# e o MFA fica desabilitado). Gere com: openssl rand -hex 32 (uma por chave)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=PREENCHER_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=PREENCHER_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=PREENCHER_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT

FRONTEND_URL=https://crm.coimbraeruas.com.br

DATABASE_URL=postgresql://chusterm:PREENCHER_SENHA_FORTE_POSTGRES@postgres:5432/chusterm_core
REDIS_URL=redis://:PREENCHER_SENHA_FORTE_REDIS@redis:6379/0

# E-mail transacional (configure com seu provedor SMTP real)
MAILER_SENDER_EMAIL=noreply@coimbraeruas.com.br
SMTP_ADDRESS=PREENCHER_HOST_SMTP
SMTP_PORT=587
SMTP_USERNAME=PREENCHER_USUARIO_SMTP
SMTP_PASSWORD=PREENCHER_SENHA_SMTP
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

ACTIVE_STORAGE_SERVICE=local

# Sentry APM (opcional)
SENTRY_DSN=

# ─── crm-service (Fastify) ───────────────────────────────────────────────────
# O serviço segue ativo (API CRM multi-tenant). OBRIGATÓRIO: CRM_DB_URL —
# sem fallback; o serviço aborta o boot se ausente.
CRM_PORT=4000
CRM_DB_URL=postgresql://chusterm:PREENCHER_SENHA_FORTE_POSTGRES@postgres:5432/chusterm_crm
CRM_REDIS_URL=redis://:PREENCHER_SENHA_FORTE_REDIS@redis:6379/1

# Gerar com: openssl rand -hex 32
SERVICE_JWT_SECRET=PREENCHER_COM_openssl_rand_hex_32
SERVICE_JWT_EXPIRY=15m

# Segredo serviço-a-serviço (header x-service-token). OBRIGATÓRIO para o
# identity-bridge emitir tokens em POST /auth/token (falha fechada 503 sem ele)
# e aceito pelo orchestrator em /skills/* e /knowledge/*.
# Gerar com: openssl rand -hex 32
SERVICE_AUTH_TOKEN=PREENCHER_COM_openssl_rand_hex_32

# Allowlist de origens CORS separada por vírgulas (vazio = nenhuma origem permitida)
CORS_ORIGIN=https://crm.coimbraeruas.com.br

# Nível de log pino dos três serviços Node (debug|info|warn|error)
LOG_LEVEL=info

# ─── Agent Orchestrator ──────────────────────────────────────────────────────
ORCHESTRATOR_PORT=4001
ORCHESTRATOR_DB_URL=postgresql://chusterm:PREENCHER_SENHA_FORTE_POSTGRES@postgres:5432/chusterm_ai
ORCHESTRATOR_REDIS_URL=redis://:PREENCHER_SENHA_FORTE_REDIS@redis:6379/2

# Gerar com: openssl rand -hex 32
CHATWOOT_WEBHOOK_SECRET=PREENCHER_COM_openssl_rand_hex_32
# SEC-02: segredo do webhook /agent/message; usar o mesmo valor na URL do
# agent_bot (?token=...) ou no header x-webhook-secret. Gerar: openssl rand -hex 32
ORCHESTRATOR_WEBHOOK_SECRET=PREENCHER_COM_openssl_rand_hex_32
CHATWOOT_BOT_TOKEN=PREENCHER_APOS_CRIAR_AGENT_BOT
CHATWOOT_BASE_URL=http://core:3000

# ─── Identity Bridge ─────────────────────────────────────────────────────────
IDENTITY_BRIDGE_PORT=4002

# ─── LLM / OpenRouter ────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_API_KEY=PREENCHER_CHAVE_OPENROUTER
LLM_MODEL=google/gemini-3.7-flash
CAPTAIN_DRA_LETICIA_LLM_MODEL=anthropic/claude-sonnet-5
CAPTAIN_DRA_LETICIA_SUMMARIZER_MODEL=google/gemini-3.7-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
CAPTAIN_MEDIA_AI_FALLBACK_MODELS=anthropic/claude-sonnet-5,google/gemini-2.5-flash
CAPTAIN_AUDIO_TRANSCRIPTION_FALLBACK_MODELS=openai/gpt-4o-mini-transcribe,openai/whisper-large-v3
ORCHESTRATOR_DRA_LETICIA_LLM_MODEL=anthropic/claude-sonnet-5
# Fallback legado lido pelo orchestrator se a variável acima estiver vazia
ORCHESTRATOR_DR_PAULA_LLM_MODEL=anthropic/claude-sonnet-5
LLM_ATTENDANCE_TEST_MODEL=deepseek/deepseek-v4-flash
LLM_CODING_TEST_MODEL=z-ai/glm-5.2
LLM_MAX_TOKENS_PER_SESSION=4096
LLM_TIMEOUT_MS=60000

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_WEBHOOK_BASE_URL=http://core:3000
# Gerar com: openssl rand -hex 24
EVOLUTION_API_KEY=PREENCHER_COM_openssl_rand_hex_24
EVOLUTION_LOG_LEVEL=WARN
# Expoe o token de cada instancia na resposta de /instance/fetchInstances.
# Deixe false salvo se alguma integracao externa depender de ler esse token
# (o core nao depende: usa so name, connectionStatus, ownerJid e telefone).
EVOLUTION_EXPOSE_TOKEN_IN_FETCH=false
# URL pública onde a Evolution API é acessível (para QR code e webhooks externos)
# Se Evolution API não for exposta diretamente, use a URL do Core
EVOLUTION_SERVER_URL=https://crm.coimbraeruas.com.br
