<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Conectando ao WhatsApp Manager...</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #0b0f19;
      color: #fff;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1.5rem;
    }
    .spinner {
      width: 48px;
      height: 48px;
      border: 3px solid rgba(255,255,255,0.15);
      border-top-color: #22c55e;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    p { color: #94a3b8; font-size: 0.95rem; }
  </style>
</head>
<body>
  <div class="spinner"></div>
  <p>Conectando ao gerenciador de WhatsApp&hellip;</p>

  <script>
    (function() {
      var apiUrl  = '<%= j @evo_api_url %>';
      var token   = '<%= j @evo_token %>';
      var version = '<%= j @evo_version %>';
      var client  = '<%= j @evo_client %>';

      // Chaves que o manager React (Evolution API v2) lê do localStorage
      try { localStorage.setItem('apiUrl',     apiUrl);  } catch(e) {}
      try { localStorage.setItem('token',      token);   } catch(e) {}
      try { localStorage.setItem('version',    version); } catch(e) {}
      try { localStorage.setItem('clientName', client);  } catch(e) {}

      // Redireciona para o dashboard do manager
      window.location.replace(apiUrl + '/manager');
    })();
  </script>
</body>
</html>
