<!DOCTYPE html>
<html class="dark" lang="pt-BR">
  <head>
    <title>Super Admin | ChusteRM</title>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <style>
      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
        margin: 0;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        color: rgb(var(--slate-12));
        background: #090a0f;
        overflow: auto;
      }

      .super-shell {
        min-height: 100vh;
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 1.04fr) minmax(420px, 0.96fr);
        background:
          linear-gradient(115deg, rgba(8, 19, 36, 0.98), rgba(13, 10, 28, 0.82) 52%, rgba(9, 10, 15, 1) 52%);
      }

      .super-editorial,
      .super-form-side {
        position: relative;
        min-width: 0;
      }

      .super-editorial {
        display: flex;
        align-items: center;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
      }

      .editorial-content {
        width: 100%;
        max-width: 42rem;
        padding: clamp(2rem, 6vw, 5rem);
      }

      .brand-row,
      .mobile-brand {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .brand-logo {
        height: 2.5rem;
        width: auto;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 0.8rem;
        border-radius: 0.75rem;
        background: rgba(38, 53, 92, 0.62);
        border: 1px solid rgba(255, 255, 255, 0.07);
        color: rgb(var(--teal-9));
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      .editorial-title,
      .form-title,
      .mobile-brand span {
        font-family: 'Inter', sans-serif;
      }

      .editorial-title {
        margin: 3.2rem 0 0;
        max-width: 12ch;
        font-size: clamp(3.15rem, 5vw, 5.1rem);
        font-weight: 800;
        line-height: 0.98;
      }

      .editorial-title span {
        color: rgb(var(--violet-9));
      }

      .editorial-copy {
        margin: 1.6rem 0 0;
        max-width: 38rem;
        font-size: 1.05rem;
        line-height: 1.85;
        color: rgb(var(--slate-11));
      }

      .editorial-grid {
        margin-top: 2.2rem;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .editorial-card {
        padding: 1.15rem;
        border-radius: 0.75rem;
        background: rgba(24, 26, 36, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 20px 55px rgba(0, 0, 0, 0.25);
      }

      .editorial-card strong,
      .trust-title {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.95rem;
        color: rgb(var(--slate-12));
      }

      .editorial-card p,
      .trust-copy {
        margin: 0;
        color: rgb(var(--slate-11));
        line-height: 1.65;
      }

      .super-form-side {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: clamp(1.25rem, 5vw, 5rem);
      }

      .form-column {
        width: min(100%, 31rem);
        max-width: 31rem;
        min-width: 0;
      }

      .mobile-brand {
        display: none;
        flex-direction: column;
        justify-content: center;
        margin-bottom: 1.5rem;
        font-size: 1.6rem;
        font-weight: 800;
        text-align: center;
      }

      .surface-card {
        width: 100%;
        max-width: 100%;
        overflow: hidden;
        padding: clamp(1.35rem, 4vw, 2.3rem);
        border-radius: 1rem;
        background: rgba(28, 29, 38, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.38);
      }

      .form-header {
        margin-bottom: 1.55rem;
      }

      .form-title {
        margin: 1rem 0 0;
        font-size: clamp(2.05rem, 4vw, 3.25rem);
        font-weight: 500;
        line-height: 1.1;
        color: rgb(var(--slate-12));
      }

      .form-subtitle {
        margin: 0.85rem 0 0;
        color: rgb(var(--slate-11));
        line-height: 1.75;
      }

      .alert-error {
        margin-bottom: 1.25rem;
        padding: 0.9rem 1rem;
        border-radius: 0.75rem;
        background: rgba(135, 28, 52, 0.24);
        border: 1px solid rgba(249, 115, 134, 0.25);
        color: #ff97a3;
        font-size: 0.92rem;
      }

      .credentials-form {
        display: grid;
        gap: 1rem;
      }

      .field-label {
        display: block;
        margin-bottom: 0.45rem;
        color: rgb(var(--teal-9));
        font-size: 0.82rem;
        font-weight: 700;
      }

      .input-shell {
        display: grid;
        grid-template-columns: 3.15rem minmax(0, 1fr);
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 0.75rem;
        background: rgba(42, 50, 70, 0.82);
        transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
      }

      .input-shell:focus-within {
        border-color: rgb(var(--violet-9));
        background: rgba(42, 50, 70, 0.96);
        box-shadow: 0 0 0 4px rgba(167, 97, 255, 0.12);
      }

      .input-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: rgb(var(--teal-9));
        pointer-events: none;
      }

      .input-icon svg {
        width: 1.15rem;
        height: 1.15rem;
      }

      .form-input {
        min-width: 0;
        width: 100%;
        padding: 0.95rem 1rem 0.95rem 0;
        border: 0;
        background: transparent;
        color: rgb(var(--slate-12));
        font-size: 0.98rem;
      }

      .form-input::placeholder {
        color: rgba(184, 193, 214, 0.48);
      }

      .form-input:focus {
        outline: none;
      }

      .form-input:-webkit-autofill,
      .form-input:-webkit-autofill:hover,
      .form-input:-webkit-autofill:focus {
        -webkit-text-fill-color: rgb(var(--slate-12));
        caret-color: rgb(var(--slate-12));
        transition: background-color 9999s ease-in-out 0s;
        box-shadow: 0 0 0 1000px rgba(42, 50, 70, 0.96) inset;
      }

      .submit-btn {
        margin-top: 0.25rem;
        width: 100%;
        border: none;
        border-radius: 0.75rem;
        padding: 1rem 1.2rem;
        font-size: 0.98rem;
        font-weight: 800;
        color: white;
        cursor: pointer;
        background: linear-gradient(135deg, #7c1cff 0%, #b000e6 100%);
        box-shadow: 0 18px 48px rgba(140, 29, 255, 0.28);
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
      }

      .submit-btn:hover {
        transform: translateY(-1px);
        filter: brightness(1.08);
        box-shadow: 0 22px 54px rgba(140, 29, 255, 0.34);
      }

      .submit-btn:active {
        transform: scale(0.99);
      }

      .trust-band {
        margin-top: 1.35rem;
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
        padding: 1rem;
        border-radius: 0.85rem;
        background: rgba(17, 31, 62, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }

      .trust-icon {
        width: 2.45rem;
        height: 2.45rem;
        flex: 0 0 2.45rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
        background: rgba(167, 97, 255, 0.18);
        color: rgb(var(--violet-9));
      }

      .footer-copy {
        margin: 1.2rem 0 0;
        color: rgba(184, 193, 214, 0.62);
        font-size: 0.75rem;
        line-height: 1.7;
        text-transform: uppercase;
      }

      @media (max-width: 1023px) {
        .super-shell {
          display: flex;
          min-height: 100vh;
          background: linear-gradient(145deg, rgba(8, 19, 36, 0.98), rgba(19, 13, 34, 0.98));
        }

        .super-editorial {
          display: none;
        }

        .super-form-side {
          width: 100%;
          align-items: flex-start;
          padding-top: 2rem;
        }

        .mobile-brand {
          display: flex;
        }
      }

      @media (max-width: 520px) {
        .super-form-side {
          padding: 1rem;
          max-width: 100vw;
          overflow: hidden;
        }

        .form-column {
          width: 100%;
          max-width: 22.5rem;
          margin-inline: 0 auto;
        }

        .surface-card {
          box-shadow: none;
        }

        .form-title {
          font-size: 1.85rem;
        }

        .input-shell {
          grid-template-columns: 2.85rem minmax(0, 1fr);
        }

        .form-subtitle,
        .trust-copy,
        .footer-copy {
          overflow-wrap: anywhere;
        }

        .trust-band {
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main class="super-shell">
      <section class="super-editorial">
        <div class="editorial-content">
          <div class="brand-row">
            <img src="/brand-assets/logo_dark.svg" alt="ChusteRM" class="brand-logo"/>
            <span class="eyebrow">Super Admin</span>
          </div>

          <h1 class="editorial-title">
            Governanca do sistema com <span>clareza.</span>
          </h1>
          <p class="editorial-copy">
            Acesse configuracoes globais, contas, seguranca e operacao da plataforma em uma area separada do atendimento diario.
          </p>

          <div class="editorial-grid">
            <article class="editorial-card">
              <strong>Controle centralizado</strong>
              <p>Administre recursos, contas e parametros da instancia sem misturar tarefas de suporte com decisoes estruturais.</p>
            </article>
            <article class="editorial-card">
              <strong>Operacao confiavel</strong>
              <p>Acesso privilegiado com interface distinta, objetiva e preparada para acoes auditaveis.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="super-form-side">
        <div class="form-column">
          <div class="mobile-brand">
            <img src="/brand-assets/logo_dark.svg" alt="ChusteRM" class="brand-logo"/>
            <span>ChusteRM</span>
            <span class="eyebrow">Super Admin</span>
          </div>

          <div class="surface-card">
            <div class="form-header">
              <span class="eyebrow">Configuracao principal</span>
              <h2 class="form-title">Entrar no painel de controle</h2>
              <p class="form-subtitle">
                Use credenciais de super admin para acessar configuracoes globais e controles operacionais da plataforma.
              </p>
            </div>

            <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
              <% if flash[:error].present? %>
                <div class="alert-error"><%= flash[:error] %></div>
              <% end %>

              <div class="credentials-form">
                <div>
                  <label class="field-label" for="super_admin_email">E-mail</label>
                  <div class="input-shell">
                    <span class="input-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67z"/>
                        <path d="M22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908z"/>
                      </svg>
                    </span>
                    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "admin@empresa.com", class: "form-input", id: "super_admin_email" %>
                  </div>
                </div>

                <div>
                  <label class="field-label" for="super_admin_password">Senha</label>
                  <div class="input-shell">
                    <span class="input-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 0 0-5.25 5.25v3a3 3 0 0 0-3 3v6.75a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3v-6.75a3 3 0 0 0-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 1 0-7.5 0v3h7.5z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    <%= f.password_field :password, autocomplete: "current-password", placeholder: "Sua senha", class: "form-input", id: "super_admin_password" %>
                  </div>
                </div>

                <button type="submit" class="submit-btn">
                  Acessar painel
                </button>
              </div>
            <% end %>

            <div class="trust-band">
              <span class="trust-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                  <path d="M12 2 4 6v6c0 5.2 3.3 8.9 8 10 4.7-1.1 8-4.8 8-10V6l-8-4Zm-1.1 13.6-3.2-3.2 1.4-1.4 1.8 1.8 4.2-4.2 1.4 1.4-5.6 5.6Z"/>
                </svg>
              </span>
              <div>
                <strong class="trust-title">Acesso isolado e rastreavel</strong>
                <p class="trust-copy">Esta area e reservada para administracao da plataforma, controle de contas e alteracoes sensiveis do sistema.</p>
              </div>
            </div>

            <p class="footer-copy">
              Acesso restrito a pessoas autorizadas. Acoes de super admin devem ser intencionais e auditaveis.
            </p>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
