<li>
  <% is_active = current_page?(url) %>
  <% link_class = is_active ? 'bg-[rgb(var(--slate-3)/0.55)] text-[rgb(var(--slate-12))]' : 'text-[rgb(var(--slate-11))] hover:bg-[rgb(var(--slate-3)/0.3)] hover:text-[rgb(var(--slate-12))]' %>
  <%= link_to(url, class: link_class + " flex items-center gap-2.5 px-3 py-2 text-sm font-medium rounded-lg transition-colors duration-150 focus:outline-none") do %>
    <svg width="16" height="16" class="flex-shrink-0 opacity-70"><use xlink:href="#<%= icon %>" /></svg>
    <span><%= label %></span>
  <% end %>
</li>
