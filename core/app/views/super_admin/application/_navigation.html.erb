<%#
# Navigation

This partial is used to display the navigation in Administrate.
By default, the navigation contains navigation links
for all resources in the admin dashboard,
as defined by the routes in the `admin/` namespace
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
  }
%>

<div class="sa-sidebar border-r border-[rgb(var(--slate-4)/0.4)] w-60 flex-shrink-0 justify-between h-full flex flex-col bg-[rgb(var(--slate-1))]" role="navigation">
  <div>
    <div class="flex items-center mx-4 mb-4 py-5">
      <%= link_to image_tag('/brand-assets/logo_thumbnail.svg', alt: 'ChusteRM Admin Dashboard', class: 'h-8'), super_admin_root_url %>
      <div class="flex flex-col ml-3">
        <div class="text-sm font-semibold text-[rgb(var(--slate-12))]">ChusteRM</div>
        <div class="text-xs text-[rgb(var(--slate-10))] mt-0.5">Console Super Admin</div>
      </div>
    </div>

    <ul class="my-2 px-2 space-y-0.5">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Painel' } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if ["account_users", "access_tokens", "installation_configs", "dashboard", "devise/sessions", "app_configs", "instance_statuses", "settings"].include?  resource.resource %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym],
            url: resource_index_route(resource),
            label: display_resource_name(resource),
          }
        %>

      <% end %>
      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>
  <div>
    <ul class="my-2 px-2 space-y-0.5 border-t border-[rgb(var(--slate-4)/0.4)] pt-3">
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Filas Sidekiq' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'Saude da instancia' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Painel de agentes' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Sair' } %>
    </ul>
  </div>
</div>
