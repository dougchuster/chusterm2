<% content_for(:title) do %>
  Configuracoes
<% end %>
<header class="flex px-6 py-4 items-center border-b border-[rgb(var(--border-subtle))] bg-[rgb(var(--bg-card))]" role="banner">
  <div class="border border-[rgb(var(--border-subtle))] mr-4 p-2 rounded-lg bg-[rgb(var(--bg-surface))]">
    <svg width="20" height="20"><use xlink:href="#icon-settings-2-line" /></svg>
  </div>
  <div class="flex flex-col h-12 justify-center">
    <h1 class="text-sm font-semibold leading-6 text-white" id="page-title">
      <%= content_for(:title) %>
    </h1>
    <p class="text-xs font-normal leading-5 m-0 text-[rgb(var(--secondary-main))]">Ajuste a instancia, recursos ativos e acesso ao faturamento</p>
  </div>
</header>
<section class="main-content__body px-6 py-6 bg-[rgb(var(--bg-app))]">
  <%# Alert removed - Enterprise features enabled %>

  <div class="py-2">
    <%= javascript_include_tag "secretField" %>
    <div class="flex items-center mb-6">
      <h4 class="text-xs font-medium leading-5 h-5 text-[rgb(var(--secondary-main))] mr-4">Identificador da instalacao</h4>
      <div data-secret-text="<%= ChatwootHub.installation_identifier %>" class="cell-data__secret-field text-xs leading-5 h-5 text-[rgb(var(--secondary-main))]">
        <span data-secret-masked="true" class="select-none"></span>
        <button type="button" onclick="toggleSecretField(event)" data-secret-toggler class="inline-flex items-center justify-center h-5 w-5 p-0 rounded text-[rgb(var(--secondary-main))] hover:text-white transition-colors focus:outline-none">
          <svg width="16" height="16" class="w-4 h-4 fill-current">
            <use xlink:href="#eye-show" />
          </svg>
        </button>
        <button type="button" onclick="copySecretField(event)" data-secret-copier class="inline-flex items-center justify-center h-5 w-5 p-0 rounded text-[rgb(var(--secondary-main))] hover:text-white transition-colors focus:outline-none">
          <svg width="16" height="16" class="w-4 h-4 fill-current">
            <use xlink:href="#icon-copy" />
          </svg>
        </button>
      </div>
    </div>
    <% if ChatwootApp.enterprise? %>
      <div class="flex p-5 outline outline-1 outline-[rgb(var(--border-subtle))] rounded-xl items-start md:items-center shadow-[0_4px_20px_rgba(0,0,0,0.4)] flex-col md:flex-row bg-[rgb(var(--bg-card))]">
        <div class="flex flex-col flex-grow gap-1">
          <div class="flex items-center gap-2">
            <h2 class="h-5 leading-5 text-white text-xs font-semibold">Plano atual</h2>
            <a href="<%= refresh_super_admin_settings_url %>" class="inline-flex gap-1 text-xs font-medium items-center text-[rgb(var(--tertiary-main))] hover:text-[rgb(var(--tertiary-hover))]">
              <svg width="14" height="14"><use xlink:href="#icon-refresh-line" /></svg>
              <span>Atualizar</span>
            </a>
          </div>
          <p class="text-[rgb(var(--secondary-main))] m-0 text-xs"><%= SuperAdmin::FeaturesHelper.plan_details %></p>
        </div>
        <a href="<%= ChatwootHub.billing_url %>" target="_blank" rel="noopener noreferrer">
          <button class="mt-4 md:mt-0 flex gap-1 items-center bg-transparent shadow-sm h-9 hover:text-white hover:bg-[rgb(var(--bg-card-hover))] outline outline-1 outline-[rgb(var(--border-subtle))] rounded-lg text-[rgb(var(--secondary-main))] font-medium px-3 py-2 focus:outline-none">
            <svg width="14" height="14"><use xlink:href="#icon-settings-2-line" /></svg>
            <span class="px-1">Gerenciar</span>
          </button>
        </a>
      </div>
    <% end %>

    <% if ChatwootHub.pricing_plan != 'community' &&  User.count > ChatwootHub.pricing_plan_quantity %>
    <div role="alert">
      <div class="border border-t-0 border-[rgb(var(--error))]/50 rounded-b bg-[rgb(var(--error))]/10 px-4 py-3 text-[rgb(var(--error))]">
        <p>Voce tem <%= User.count %> agentes. Adicione mais licencas para incluir novos usuarios.</p>
      </div>
    </div>
    <% end %>


    <div class="flex p-5 outline outline-1 outline-[rgb(var(--border-subtle))] rounded-xl mt-4 items-start md:items-center shadow-[0_4px_20px_rgba(0,0,0,0.4)] flex-col md:flex-row bg-[rgb(var(--bg-card))]">
      <div class="flex flex-col flex-grow gap-1">
        <h2 class="h-5 leading-5 text-white text-xs font-semibold">Precisa de ajuda?</h2>
        <p class="text-[rgb(var(--secondary-main))] m-0 text-xs">Encontrou algum problema? Estamos aqui para ajudar.</p>
      </div>
      <a href="https://discord.gg/cJXdrwS" target="_blank">
        <button class="flex mt-4 md:mt-0 gap-1 items-center shadow-sm h-9 bg-[rgb(var(--tertiary-main))] hover:bg-[rgb(var(--tertiary-hover))] text-black border border-solid border-[rgb(var(--tertiary-main))] rounded-lg font-medium px-3 focus:outline-none">
          <svg class="h-4 w-4" width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13.209 3.103c-.495-1.004-1.926-1.004-2.421 0L8.43 7.88l-5.273.766c-1.107.161-1.55 1.522-.748 2.303l3.815 3.72-.9 5.25c-.19 1.103.968 1.944 1.959 1.424l4.715-2.48 4.716 2.48c.99.52 2.148-.32 1.96-1.424l-.902-5.25 3.816-3.72c.8-.78.359-2.142-.748-2.303l-5.273-.766-2.358-4.777ZM9.74 8.615l2.258-4.576 2.259 4.576a1.35 1.35 0 0 0 1.016.738l5.05.734-3.654 3.562a1.35 1.35 0 0 0-.388 1.195l.862 5.03-4.516-2.375a1.35 1.35 0 0 0-1.257 0l-4.516 2.374.862-5.029a1.35 1.35 0 0 0-.388-1.195l-3.654-3.562 5.05-.734c.44-.063.82-.34 1.016-.738ZM1.164 3.782a.75.75 0 0 0 .118 1.054l2.5 2a.75.75 0 1 0 .937-1.172l-2.5-2a.75.75 0 0 0-1.055.118Z" fill="currentColor"/><path d="M22.836 18.218a.75.75 0 0 0-.117-1.054l-2.5-2a.75.75 0 0 0-.938 1.172l2.5 2a.75.75 0 0 0 1.055-.117ZM1.282 17.164a.75.75 0 1 0 .937 1.172l2.5-2a.75.75 0 0 0-.937-1.172l-2.5 2ZM22.836 3.782a.75.75 0 0 1-.117 1.054l-2.5 2a.75.75 0 0 1-.938-1.172l2.5-2a.75.75 0 0 1 1.055.118Z"  fill="currentColor"/></svg>
          <span class="px-1">Suporte da comunidade</span>
        </button>
      </a>
      <% if ChatwootHub.pricing_plan !='community' %>
        <button class="ml-4 flex gap-1 items-center bg-transparent h-9 hover:text-white hover:bg-[rgb(var(--bg-card-hover))] border border-solid border-[rgb(var(--border-subtle))] rounded-lg text-[rgb(var(--secondary-main))] font-medium px-3 focus:outline-none" onclick="window.$chatwoot.toggle('open')">
          <svg class="h-4 w-4" width="24" height="24" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M13.209 3.103c-.495-1.004-1.926-1.004-2.421 0L8.43 7.88l-5.273.766c-1.107.161-1.55 1.522-.748 2.303l3.815 3.72-.9 5.25c-.19 1.103.968 1.944 1.959 1.424l4.715-2.48 4.716 2.48c.99.52 2.148-.32 1.96-1.424l-.902-5.25 3.816-3.72c.8-.78.359-2.142-.748-2.303l-5.273-.766-2.358-4.777ZM9.74 8.615l2.258-4.576 2.259 4.576a1.35 1.35 0 0 0 1.016.738l5.05.734-3.654 3.562a1.35 1.35 0 0 0-.388 1.195l.862 5.03-4.516-2.375a1.35 1.35 0 0 0-1.257 0l-4.516 2.374.862-5.029a1.35 1.35 0 0 0-.388-1.195l-3.654-3.562 5.05-.734c.44-.063.82-.34 1.016-.738ZM1.164 3.782a.75.75 0 0 0 .118 1.054l2.5 2a.75.75 0 1 0 .937-1.172l-2.5-2a.75.75 0 0 0-1.055.118Z" fill="currentColor"/><path d="M22.836 18.218a.75.75 0 0 0-.117-1.054l-2.5-2a.75.75 0 0 0-.938 1.172l2.5 2a.75.75 0 0 0 1.055-.117ZM1.282 17.164a.75.75 0 1 0 .937 1.172l2.5-2a.75.75 0 0 0-.937-1.172l-2.5 2ZM22.836 3.782a.75.75 0 0 1-.117 1.054l-2.5 2a.75.75 0 0 1-.938-1.172l2.5-2a.75.75 0 0 1 1.055.118Z"  fill="currentColor"/></svg>
          <span class="px-1">Suporte por chat</span>
        </button>
      <% end %>
    </div>
    <div class="mt-10 py-4">
      <h3 class="h-5 leading-5 text-white font-semibold text-sm">Recursos</h3>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-4">
      <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
        <div class="group outline outline-1 outline-[rgb(var(--border-subtle))] p-5 rounded-xl relative shadow-[0_4px_20px_rgba(0,0,0,0.4)] bg-[rgb(var(--bg-card))]">
          <span class="<%= attrs[:enabled] ? 'bg-[rgb(var(--success))] text-white': 'bg-[rgb(var(--bg-card-hover))] text-[rgb(var(--secondary-main))]' %> absolute rounded-full p-1.5 inline-flex right-4 top-4">
            <svg width="12" height="12"><use xlink:href="<%= attrs[:enabled] ? '#icon-tick-line': '#icon-lock-line' %>" /></svg>
          </span>
          <div class="visible <% if !attrs[:enabled] %> group-hover:invisible <% end %> flex items-center justify-center w-10 h-10 mb-2 border border-[rgb(var(--border-subtle))] border-solid text-[rgb(var(--secondary-main))] rounded-full">
            <svg width="18" height="18"><use xlink:href="#<%= attrs[:icon] %>" /></svg>
          </div>
          <% if !attrs[:enabled] %>
          <div class="flex h-9 absolute top-4 items-center invisible group-hover:visible">
            <% if ChatwootApp.enterprise? %>
              <%= render 'upgrade_button_enterprise' %>
            <% else %>
              <%= render 'upgrade_button_community' %>
            <% end %>
          </div>
          <% end %>
          <div class="flex items-center justify-between mb-1.5 mt-4">
            <div class="flex items-center gap-2">
              <h3 class="text-white font-medium text-sm"><%= attrs[:name] %></h3>
              <% if attrs[:enterprise] %>
                <span class="px-2 h-4 leading-4 rounded-lg text-[rgb(var(--success))] font-medium bg-[rgb(var(--success))]/10 text-[10px]">EE</span>
              <% end %>
              <% if attrs[:config_key].present? && attrs[:enabled] %>
                <a class="inline-flex items-center justify-center h-6 w-6 hover:bg-[rgb(var(--bg-card-hover))] rounded-md" href="/super_admin/app_config?config=<%= attrs[:config_key] %>">
                  <svg width="16" height="16"><use xlink:href="#icon-gear" /></svg>
                </a>
              <% end %>
            </div>
          </div>
          <p class="text-[rgb(var(--secondary-main))] mb-0 text-xs leading-5"><%= attrs[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
