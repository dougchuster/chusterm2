<p>Olá <%= @resource.name %>,</p>

<% account_user = @resource&.account_users&.first %>
<% account = account_user&.account %>
<% is_saml_account = account&.saml_enabled? %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <% if is_saml_account %>
    <p><%= account_user.inviter.name %>, da equipe <%= account_user.account.name %>, convidou você para acessar o <%= global_config['BRAND_NAME'] || 'ChusteRM' %> via Login Único (SSO).</p>
    <p>Sua organização usa SSO para autenticação segura. Você não precisará de senha para acessar sua conta.</p>
  <% else %>
    <p><%= account_user.inviter.name %>, da equipe <%= account_user.account.name %>, convidou você para conhecer o <%= global_config['BRAND_NAME'] || 'ChusteRM' %>.</p>
  <% end %>
<% end %>

<% if @resource.confirmed? %>
  <p>Você pode acessar sua conta no <%= global_config['BRAND_NAME'] || 'ChusteRM' %> pelo link abaixo:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
  <p>
    Bem-vindo ao <%= global_config['BRAND_NAME'] || 'ChusteRM' %>! Temos um conjunto de ferramentas poderosas prontas para você explorar. Antes disso, precisamos verificar o seu endereço de e-mail para confirmar que é você mesmo.
  </p>
  <% end %>
  <% unless is_saml_account %>
  <p>Por favor, clique no link abaixo para ativar sua conta.</p>
  <% end %>
<% end %>


<% if @resource.unconfirmed_email.present? %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% elsif @resource.confirmed? %>
  <% if is_saml_account %>
    <p>Você pode acessar sua conta pelo portal SSO da sua organização.</p>
  <% else %>
    <p><%= link_to 'Entrar na minha conta', frontend_url('auth/sign_in') %></p>
  <% end %>
<% elsif account_user&.inviter.present? %>
  <% if is_saml_account %>
    <p>Você pode acessar sua conta pelo portal SSO da sua organização.</p>
  <% else %>
    <p><%= link_to 'Confirmar minha conta', frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %></p>
  <% end %>
<% else %>
  <p><%= link_to 'Confirmar minha conta', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% end %>
